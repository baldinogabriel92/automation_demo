# mock (default) runs deterministic local stand-ins: no key, no network.
# live calls the Anthropic API via the official SDK.
MODE=mock

# Only needed when MODE=live
ANTHROPIC_API_KEY=sk-ant-...

# Local webhook server port
PORT=8787

# Shared secret for the Cloudflare Worker endpoint (wrangler secret put WEBHOOK_SECRET)
WEBHOOK_SECRET=
